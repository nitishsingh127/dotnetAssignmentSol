// Assignment 2: Desktop UI Responsiveness & Progress Reporting
// Objective: Simulate a heavy background task in a desktop app (or simulation console) while updating the UI.
// Task: Create a file processing simulator.
// Requirements:
// Simulate processing 100 files in a loop.
// Each file takes 100ms to process (use Task.Delay).
// Implement an IProgress<int> parameter to report the percentage completion back to the caller.
// Ensure the caller updates a progress bar or text output in real-time without freezing.
// Key Concepts: IProgress<T>, Task.Delay, Thread marshalling.
 
using System;
using System.Threading.Tasks;
 
class Program
{
    static void ShowProgress(int percentage)
    {
        Console.Write($"\rProcessing: {percentage}%");
    }
    static async Task Main()
    {
        IProgress<int> progress =
            new Progress<int>(ShowProgress);
 
        for (int i = 1; i <= 100; i++)
        {
            await Task.Delay(100);
            progress.Report(i);
        }
        Console.WriteLine("\nCompleted!");
    }
}
 
