// Assignment 1: Async/Await Basics & I/O Operations
// Objective: Learn to download web content asynchronously without blocking the main execution thread.
// Task: Create a console application that takes an array of 3 website URLs.
// Requirements:
// Use HttpClient to download the HTML content of all three sites.
// Download the pages concurrently using Task.WhenAll.
// Measure and display the total execution time.
// Print the character count of each website's HTML.
// Key Concepts: async, await, Task.WhenAll, HttpClient.
//================================================================================================================================================
 
using System;
using System.Collections.Generic;
using System.Net.Http;
using System.Threading.Tasks;
 
class Program
{
    static async Task Main()
    {
        string[] urls =
        {
            "https://www.microsoft.com",
            "https://www.google.com",
            "https://www.github.com"
        };
 
        HttpClient client = new HttpClient();
 
        List<Task<string>> downloadTasks = new List<Task<string>>();
 
        foreach (string url in urls)
        {
            Task<string> task = client.GetStringAsync(url);
            downloadTasks.Add(task);
        }
 
        string[] htmlPages = await Task.WhenAll(downloadTasks);
 
        for (int i = 0; i < htmlPages.Length; i++)
        {
            Console.WriteLine($"URL: {urls[i]}");
            Console.WriteLine($"Character Count: {htmlPages[i].Length}");
            Console.WriteLine();
        }
    }
}
 
 
