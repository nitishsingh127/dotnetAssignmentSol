// Assignment 3: Cancellation Tokens & Exception Handling
// Objective: Handle user cancellation requests and clean up asynchronous resources safely.
// Task: Build a search tool that scans a mock database for a specific keyword.
// Requirements:
// The search takes 5 seconds to complete.
// Pass a CancellationToken to the search method.
// If the user presses the 'C' key, trigger the cancellation.
// Catch the OperationCanceledException properly and display a "Search canceled" message.
// Wrap the logic to handle unexpected HttpRequestException scenarios gracefully.  
// Key Concepts: CancellationTokenSource, CancellationToken, try-catch with async.

 using System; 
using System.Threading;
using System.Threading.Tasks;
using System.Net.Http;
 
class Program
{
    static async Task Main()
    {
        CancellationTokenSource cts =
            new CancellationTokenSource();
 
        Console.WriteLine("Press 'C' to cancel search.");
        Console.WriteLine();
 
        Task cancelTask = Task.Run(() =>
        {
            if (Console.ReadKey(true).Key == ConsoleKey.C)
            {
                cts.Cancel();
            }
        });
 
        try
        {
            string result =
                await SearchDatabaseAsync(
                    "Mango",
                    cts.Token);
 
            Console.WriteLine($"Search Result: {result}");
        }
        catch (OperationCanceledException)
        {
            Console.WriteLine("Search canceled.");
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine(
                $"Network Error: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Unexpected Error: {ex.Message}");
        }
    }
 
    static async Task<string> SearchDatabaseAsync(
        string keyword,
        CancellationToken token)
    {
        string[] database =
        {
            "Apple",
            "Banana",
            "Orange",
            "Mango",
            "Grapes"
        };
 
        Console.WriteLine("Searching...");
 
        for (int i = 0; i < 5; i++)
        {
            token.ThrowIfCancellationRequested();
 
            await Task.Delay(1000, token);
 
            Console.WriteLine(
                $"Scanning records... {i + 1}/5");
        }
 
        foreach (string item in database)
        {
            if (item.Equals(
                keyword,
                StringComparison.OrdinalIgnoreCase))
            {
                return item;
            }
        }
 
        return "Not Found";
    }
}
 
