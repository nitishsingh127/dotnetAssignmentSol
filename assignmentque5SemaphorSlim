
using System;
using System.Collections.Generic;
using System.Threading;
using System.Threading.Tasks;

class Program
{
    static SemaphoreSlim semaphore = new SemaphoreSlim(4);
    static async Task ProcessImageAsync(int imageId)
    {
        Console.WriteLine($"Image {imageId} waiting...");
        await semaphore.WaitAsync();

        Console.WriteLine($"Image {imageId} entered pipeline");
        Console.WriteLine($"Image {imageId} processing...");

        await Task.Delay(2000);

        Console.WriteLine($"Image {imageId} completed");
        Console.WriteLine($"Image {imageId} exited");

        semaphore.Release();
    }
    static async Task Main(string[] args)
    {
        List<Task> tasks = new List<Task>();
        for (int i = 1; i <= 50; i++)
        {
            tasks.Add(ProcessImageAsync(i));
        }
        await Task.WhenAll(tasks);
        Console.WriteLine("All images processed.");
    }
}
