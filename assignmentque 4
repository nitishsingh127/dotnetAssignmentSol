using System;
using System.Collections.Generic;
using System.Threading.Tasks;

class Program
{
    static async IAsyncEnumerable<double> ReadSensorDataAsync()
    {
        Random random = new Random();
        for (int i = 0; i < 10; i++)
        {
            await Task.Delay(500);
            double temp = 20 + random.NextDouble() * 15;
            yield return temp;
        }
    }

    static async Task Main()
    {
        Console.WriteLine("Reading Sensor Data.\n");
        await foreach (double temp in ReadSensorDataAsync())
        {
            // Filter temperatures above 30°C
            if (temp <= 30)
            {
                Console.WriteLine($"Temperature: {temp:F2} °C");
            }
        }
        Console.WriteLine("\nSensor stream completed.");
    }
}
